<?xml version="1.0" encoding="utf-8"?>
<TextureAtlas>
  <!-- Points directly to your hollow knight image file name in Content/images -->
  <Texture>images/hollowknight</Texture>
  
  <Regions>
    <!-- Row 1: Standing Idle Frame -->
    <Region name="hk-idle-1" x="0" y="0" width="128" height="128" />

    <!-- Row 2: Walking Animation Frames (First 8 steps across the row) -->
    <Region name="hk-walk-1" x="0"   y="128" width="128" height="128" />
    <Region name="hk-walk-2" x="128" y="128" width="128" height="128" />
    <Region name="hk-walk-3" x="256" y="128" width="128" height="128" />
    <Region name="hk-walk-4" x="384" y="128" width="128" height="128" />
    <Region name="hk-walk-5" x="512" y="128" width="128" height="128" />
    <Region name="hk-walk-6" x="640" y="128" width="128" height="128" />
    <Region name="hk-walk-7" x="768" y="128" width="128" height="128" />
    <Region name="hk-walk-8" x="896" y="128" width="128" height="128" />
  </Regions>
  
  <Animations>
    <!-- Static loop for when the player stops moving -->
    <Animation name="hk-idle" delay="200">
      <Frame region="hk-idle-1" />
    </Animation>
    
    <!-- Smooth continuous walking cycle loop -->
    <Animation name="hk-walk" delay="100">
      <Frame region="hk-walk-1" />
      <Frame region="hk-walk-2" />
      <Frame region="hk-walk-3" />
      <Frame region="hk-walk-4" />
      <Frame region="hk-walk-5" />
      <Frame region="hk-walk-6" />
      <Frame region="hk-walk-7" />
      <Frame region="hk-walk-8" />
    </Animation>
  </Animations>
</TextureAtlas>
