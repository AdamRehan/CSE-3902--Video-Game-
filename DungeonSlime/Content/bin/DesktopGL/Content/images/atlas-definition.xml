<?xml version="1.0" encoding="utf-8"?>
<!-- Corrected Hollow Knight Texture Atlas: Walking on Row 1 -->
<TextureAtlas>
  <Texture>images/knight</Texture>
  
  <Regions>
    <!-- Row 1: Walking Sequence Frames (y="0") -->
    <Region name="hk-walk-1" x="0"   y="0" width="128" height="128" />
    <Region name="hk-walk-2" x="128" y="0" width="128" height="128" />
    <Region name="hk-walk-3" x="256" y="0" width="128" height="128" />
    <Region name="hk-walk-4" x="384" y="0" width="128" height="128" />
    <Region name="hk-walk-5" x="512" y="0" width="128" height="128" />
    <Region name="hk-walk-6" x="640" y="0" width="128" height="128" />
    <Region name="hk-walk-7" x="768" y="0" width="128" height="128" />
    <Region name="hk-walk-8" x="896" y="0" width="128" height="128" />

    <!-- Idle Frame: We can reuse the first frame of the walk loop for standing still -->
    <Region name="hk-idle-1" x="0" y="0" width="128" height="128" />
  </Regions>
  
  <Animations>
    <!-- Quiet breathing idle loop state -->
    <Animation name="hk-idle" delay="200">
      <Frame region="hk-idle-1" />
    </Animation>
    
    <!-- Fluid walking loop processing row 1 entries -->
    <Animation name="hk-walk" delay="90">
      <Frame region="hk-walk-1" />
      <Frame region="hk-walk-2" />
      <Frame region="hk-walk-3" />
      <Frame region="hk-walk-4" />
      <Frame region="hk-walk-5" />
      <Frame region="hk-walk-6" />
      <Frame region="hk-walk-7" />
      <Frame region="hk-walk-8" />
    </Animation>
  </Animations>
</TextureAtlas>
